{
  "name": "radency-rentals",
  "main": "index.ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
